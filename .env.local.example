# Base URL of the BODA backend API (NestJS), including version prefix.
NEXT_PUBLIC_API_URL=https://boda-frontend-xi.vercel.app/api/v1

# Google sign-in: OAuth 2.0 "Web application" client ID from Google Cloud
# Console. Must match the backend's GOOGLE_CLIENT_ID, and http://localhost:3000
# must be listed under the client's authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public site URL, used for absolute metadata (OpenGraph, canonical, etc).
# Set this to the deployed origin in production.
NEXT_PUBLIC_SITE_URL=https://boda-frontend-xi.vercel.app/
